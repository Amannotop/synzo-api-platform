{
  "name": "synzo-api-platform",
  "version": "1.0.0",
  "private": true,
  "description": "Multi-customer OpenAI-compatible AI API platform",
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@11.25.0",
  "scripts": {
    "build": "pnpm run build:packages && pnpm --filter @synzo/api run build && pnpm --filter @synzo/dashboard run build",
    "dev": "pnpm --parallel --filter @synzo/api --filter @synzo/dashboard run dev",
    "dev:api": "pnpm --filter @synzo/api run dev",
    "dev:dashboard": "pnpm --filter @synzo/dashboard run dev",
    "migrate": "pnpm --filter @synzo/database run migrate",
    "db:seed": "pnpm --filter @synzo/database run seed",
    "start": "pnpm --filter @synzo/api run start",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p apps/dashboard/tsconfig.json",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "verify": "pnpm run typecheck && pnpm run lint && pnpm run test",
    "build:packages": "pnpm --filter @synzo/types run build && pnpm --filter @synzo/config run build && pnpm --filter @synzo/validation run build && pnpm --filter @synzo/database run build",
    "check:start": "node scripts/check-start.mjs",
    "verify:dist": "pnpm run build && pnpm run check:start"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@fastify/cookie": "^11.0.2",
    "@fastify/cors": "^10.0.1",
    "@fastify/helmet": "^13.0.0",
    "@types/node": "^22.10.2",
    "drizzle-orm": "^0.45.3",
    "eslint": "^9.17.0",
    "fastify": "^5.2.0",
    "globals": "^17.12.0",
    "ioredis": "^5.4.2",
    "postgres": "^3.4.5",
    "prettier": "^3.4.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.1",
    "vitest": "^3.2.4",
    "zod": "^3.24.1"
  }
}
