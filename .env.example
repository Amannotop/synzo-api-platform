# ---------------------------------------------------------------------------
# Synzo API Platform — environment template
# Copy to .env and fill in real values. ONLY this file is committed.
#   cp .env.example .env
# ---------------------------------------------------------------------------

NODE_ENV=development
PORT=3000
HOST=0.0.0.0
LOG_LEVEL=info

# --- Database (PostgreSQL 14+) --------------------------------------------
DATABASE_URL=postgresql://synzo:synzo@localhost:5432/synzo_api
DATABASE_POOL_MAX=10

# --- Redis / Valkey --------------------------------------------------------
# Used for distributed rate limiting, concurrency tracking and short-lived counters.
# Never used to cache AI responses: those can contain customer-private data.
REDIS_URL=redis://localhost:6379

# --- Upstream provider (OpenCode Zen) -------------------------------------
UPSTREAM_BASE_URL=https://opencode.ai/zen/v1
UPSTREAM_CHAT_COMPLETIONS_PATH=/chat/completions
UPSTREAM_MODELS_PATH=/models

# LEAVE EMPTY unless the provider requires auth.
# Verified: sending ANY Authorization header upstream causes OpenCode to return
# 401, even a bogus one. When empty, no auth header is sent at all.
UPSTREAM_API_KEY=

UPSTREAM_CONNECT_TIMEOUT=10000
UPSTREAM_REQUEST_TIMEOUT=120000
UPSTREAM_STREAM_TIMEOUT=300000
UPSTREAM_MAX_RETRIES=1

DEFAULT_MODEL=space-bunny-free

# --- Default per-customer limits (admin can override per customer) ---------
DEFAULT_REQUESTS_PER_MINUTE=60
DEFAULT_REQUESTS_PER_DAY=10000
DEFAULT_TOKENS_PER_DAY=1000000
DEFAULT_MAX_CONCURRENT_REQUESTS=10

# --- Request shape limits --------------------------------------------------
MAX_REQUEST_BODY_BYTES=1048576
MAX_MESSAGES=200
MAX_MESSAGE_CHARS=100000
MAX_CONTENT_TOKENS_HARD_CAP=8000

# --- Security --------------------------------------------------------------
# Generate both with:  openssl rand -hex 32
API_KEY_PEPPER=
SESSION_SECRET=

SESSION_TTL_HOURS=24
SESSION_COOKIE_NAME=synzo_session
SESSION_COOKIE_SECURE=false
BCRYPT_ISH_SCRYPT_N=32768
PASSWORD_MAX_LENGTH=256

LOGIN_MAX_ATTEMPTS=10
LOGIN_ATTEMPT_WINDOW=900
LOGIN_LOCKOUT_SECONDS=900

# --- Admin bootstrap -------------------------------------------------------
# The first registered user becomes admin automatically while no admin exists.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# --- CORS ------------------------------------------------------------------
# Comma-separated allowlist. Empty = same-origin only.
CORS_ORIGINS=
TRUST_PROXY=false

# --- Logging ---------------------------------------------------------------
# Content logging is OFF by default and should stay off in production.
# When enabled, message content is stored in requests.request_content.
LOG_REQUEST_CONTENT=false
LOG_REQUEST_CONTENT_MAX_CHARS=0

# --- Provider health monitoring -------------------------------------------
PROVIDER_HEALTH_ENABLED=true
PROVIDER_HEALTH_INTERVAL_MS=300000

# --- Features --------------------------------------------------------------
REGISTRATION_ENABLED=true
# Live (sk_live_) keys require an admin to grant per-customer access.
ALLOW_LIVE_KEYS=false

DASHBOARD_ORIGIN=http://localhost:5173

# --- Account recovery and email verification (§8) -------------------------
# The public origin customers can reach. Reset and verification links are
# built from this, so an unreachable value means dead recovery emails.
PUBLIC_BASE_URL=http://localhost:5173

# 'log' prints emails to stdout and is REJECTED when NODE_ENV=production,
# because a reset link in the log stream is a working credential.
MAIL_TRANSPORT=log
MAIL_FROM=Synzo <no-reply@synzo.local>
# Required when MAIL_TRANSPORT=smtp, e.g.
#   smtps://user:pass@mail.example.com:465
SMTP_URL=
