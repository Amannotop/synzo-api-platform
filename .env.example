# ---------------------------------------------------------------------------
# Synzo API Platform — environment template
# Copy to .env and fill in real values. ONLY this file is committed.
#   cp .env.example .env
# ---------------------------------------------------------------------------

NODE_ENV=development
PORT=3000
HOST=0.0.0.0
LOG_LEVEL=info

# --- Database (PostgreSQL 14+) --------------------------------------------
DATABASE_URL=postgresql://synzo:synzo@localhost:5432/synzo_api
DATABASE_POOL_MAX=10

# --- Redis / Valkey --------------------------------------------------------
# Used for distributed rate limiting, concurrency tracking and short-lived counters.
# Never used to cache AI responses: those can contain customer-private data.
REDIS_URL=redis://localhost:6379

# --- Upstream provider (OpenCode Zen) -------------------------------------
UPSTREAM_BASE_URL=https://opencode.ai/zen/v1
UPSTREAM_CHAT_COMPLETIONS_PATH=/chat/completions
UPSTREAM_MODELS_PATH=/models

# LEAVE EMPTY unless the provider requires auth.
# Verified: sending ANY Authorization header upstream causes OpenCode to return
# 401, even a bogus one. When empty, no auth header is sent at all.
UPSTREAM_API_KEY=

UPSTREAM_CONNECT_TIMEOUT=10000
UPSTREAM_REQUEST_TIMEOUT=120000
UPSTREAM_STREAM_TIMEOUT=300000
UPSTREAM_MAX_RETRIES=1

DEFAULT_MODEL=max

# --- Default per-customer limits (admin can override per customer) ---------
DEFAULT_REQUESTS_PER_MINUTE=60
DEFAULT_REQUESTS_PER_DAY=10000
DEFAULT_TOKENS_PER_DAY=1000000
DEFAULT_MAX_CONCURRENT_REQUESTS=10

# --- Request shape limits --------------------------------------------------
MAX_REQUEST_BODY_BYTES=1048576
MAX_MESSAGES=200
MAX_MESSAGE_CHARS=100000
MAX_CONTENT_TOKENS_HARD_CAP=8000

# --- Security --------------------------------------------------------------
# Generate both with:  openssl rand -hex 32
API_KEY_PEPPER=
SESSION_SECRET=

SESSION_TTL_HOURS=24
SESSION_COOKIE_NAME=synzo_session
SESSION_COOKIE_SECURE=false
BCRYPT_ISH_SCRYPT_N=32768
PASSWORD_MAX_LENGTH=256

LOGIN_MAX_ATTEMPTS=10
LOGIN_ATTEMPT_WINDOW=900
LOGIN_LOCKOUT_SECONDS=900

# --- Admin bootstrap -------------------------------------------------------
# The address that should hold the admin role. A signup using this address
# becomes an active admin immediately, skipping the approval queue. Compared
# case-insensitively. Leave blank to rely on the fallback below.
#
# With this blank, the FIRST account to register on an instance becomes admin
# while no admin exists yet. That fallback exists so a fresh deploy is usable
# with zero configuration -- but on a publicly reachable signup form it also
# means whoever registers first takes control of the platform, so set this
# before exposing the site.
ADMIN_EMAIL=
# Reserved. Not read by any code path: password is always the one chosen on
# the signup or password-change form. Listed so an existing deployment is not
# surprised by it doing nothing.
ADMIN_PASSWORD=

# --- CORS ------------------------------------------------------------------
# Comma-separated allowlist. Empty = same-origin only. Needed only when the
# dashboard is served from a different origin than the API; when a reverse proxy
# serves both from one host, leave it empty.
CORS_ORIGINS=
# Set true ONLY when the app really is behind a reverse proxy (Nginx, Caddy,
# Cloudflare, a platform load balancer). It makes the app trust
# X-Forwarded-Proto / X-Forwarded-Host, so reset links get the right https://
# scheme and domain instead of the internal hostname. Leave false when clients
# can reach the app directly, or a client could spoof those headers.
TRUST_PROXY=false

# --- Logging ---------------------------------------------------------------
# Content logging is OFF by default and should stay off in production.
# When enabled, message content is stored in requests.request_content.
LOG_REQUEST_CONTENT=false
LOG_REQUEST_CONTENT_MAX_CHARS=0

# --- Provider health monitoring -------------------------------------------
PROVIDER_HEALTH_ENABLED=true
PROVIDER_HEALTH_INTERVAL_MS=300000

# --- Features --------------------------------------------------------------
REGISTRATION_ENABLED=true
# Live (sk_live_) keys require an admin to grant per-customer access.
ALLOW_LIVE_KEYS=false

DASHBOARD_ORIGIN=http://localhost:5173

# --- Account recovery and email verification (§8) -------------------------
# The public origin customers can reach, used to build reset and verification
# links. LEAVE THIS EMPTY to have it detected from each request, which is what
# you want in most deployments: the app then works on any domain, and a staging
# copy on a different hostname still mints working links. Set it only to pin the
# value, e.g. https://api.yourdomain.com.
PUBLIC_BASE_URL=

# 'log' prints emails to stdout and is REJECTED when NODE_ENV=production,
# because a reset link in the log stream is a working credential.
MAIL_TRANSPORT=log
MAIL_FROM=Synzo <no-reply@synzo.local>
# Required when MAIL_TRANSPORT=smtp, e.g.
#   smtps://user:pass@mail.example.com:465
SMTP_URL=

# --- Single-origin serving -------------------------------------------------
# Serve the built dashboard from the API process so the dashboard, the API and
# the tunnel all share one origin. CORS then stops being load-bearing for the
# dashboard, and only one tunnel forward is needed. Turn this off for `pnpm
# dev`, where Vite serves the SPA on its own port.
SERVE_DASHBOARD=true
# Path is resolved against the repository root when relative.
DASHBOARD_DIST=apps/dashboard/dist

# --- Metrics ---------------------------------------------------------------
# `GET /metrics` in Prometheus text format, for Prometheus or the dashboard's
# Operations page.
METRICS_ENABLED=true
# Optional bearer token for /metrics. Loopback callers never need it. Set a
# value to require one before non-loopback access is allowed; leave empty to
# keep the endpoint loopback-only.
METRICS_TOKEN=

# --- Retention -------------------------------------------------------------
# Deletes request rows older than this, plus expired sessions and account
# tokens. usage_daily aggregates and audit logs are left intact.
REQUEST_RETENTION_DAYS=90
RETENTION_INTERVAL_MS=86400000
RETENTION_ENABLED=true

# ===========================================================================
# Credits, approvals and payments
# ===========================================================================
# Every value here is a DEFAULT, not a per-customer decision. Prices and
# credit allocations live in the admin dashboard and are read from the
# database at request time, so a customer can never influence either by
# changing what they send.

# --- Account approval ------------------------------------------------------
# When true, a newly registered account is `pending` and cannot make API calls
# until an administrator approves it. Set false to let new sign-ups through
# immediately, which also means they get the free trial at that point.
APPROVAL_REQUIRED=true

# --- The one-time free trial ----------------------------------------------
# Token credits granted at approval, once per customer, ever. A retried or
# repeated approval adds nothing further. 0 disables the trial entirely, in
# which case approval activates the account without crediting it.
FREE_TRIAL_TOKENS=500000

# --- Payment uploads -------------------------------------------------------
# Largest accepted payment receipt or QR image, in bytes. Enforced on the
# decoded image as well as the submitted string, so a client cannot lie about
# the size of what it sent. Raise for high-resolution phone screenshots.
PAYMENT_MAX_UPLOAD_BYTES=5000000

# --- Credit reservations ---------------------------------------------------
# A reservation is an upper bound on what one in-flight request can cost. It is
# what stops concurrent requests from jointly spending more than the balance
# holds, and it is released (less whatever was really used) when the request
# settles.
#
# The default is deliberately far below the provider's own output cap. Taking
# the cap literally would mean only two concurrent unbounded requests fit
# inside a 500k trial, so ordinary customers would be told they are out of
# credits while demonstrably holding half a million of them. A request whose
# real usage exceeds its reservation is charged up to what it held and the
# discrepancy is logged; the provider's own count is always recorded in the
# `requests` table so it can be reconciled.
CREDIT_MAX_RESERVATION_TOKENS=32000

# How often reservations orphaned by a crash are reclaimed. A lost reservation
# freezes the tokens it held until it is swept. The default is a quarter of the
# staleness window, so recovery is reasonably prompt while a live request is
# never at risk. 0 disables the sweeper.
CREDIT_RESERVATION_SWEEP_INTERVAL_MS=60000

# --- Telegram payment notifications ----------------------------------------
# Optional. When BOTH are set, each submitted payment is announced to the
# chat; when either is missing, submissions still work and the dashboard shows
# the notification as not sent, with a manual retry.
#
# To set up: message @BotFather, /newbot, and copy the token it gives you.
# Then message your bot, and open https://api.telegram.org/bot<TOKEN>/getUpdates
# to find the chat id (it is the "chat":{"id":...} field; a group id is
# negative). Keep the bot in the group, or send it a message, so it may message
# you.
#
# These are read only by the server-side notifier. They are never included in
# an API response, the dashboard bundle or a log line.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# How long to wait on Telegram before giving up. Kept short on purpose: a
# notification is a side effect of a submission, and the customer must not be
# held waiting on a third party to learn their claim was recorded.
TELEGRAM_TIMEOUT_MS=5000

# --- Image input ------------------------------------------------------------
# Chat messages accept OpenAI-style `image_url` content parts. A `data:` URL or
# an `https://` URL only; plain http is refused because a URL swapped in transit
# would show the model something the customer never chose. png, jpeg and webp
# only — svg is the one image format that can carry script.
#
# MAX_IMAGE_BYTES is measured on the DECODED bytes, not the base64 text, since
# that is the number that reaches the provider. Note the interaction with
# MAX_REQUEST_BODY_BYTES above: base64 inflates by 4/3, so with the default 1MB
# body limit the largest image that can actually arrive is about 750KB however
# high MAX_IMAGE_BYTES is set. Raise both together for larger images.
#
# Whether a given customer may send one is a plan entitlement, not a global
# switch: it comes from their package's image_support, enforced on the API path
# as `image_support_required`. Set this to 0 to turn image input off platform-wide.
MAX_IMAGES_PER_REQUEST=64
MAX_IMAGE_BYTES=5000000
